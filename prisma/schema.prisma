generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReservationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum MesaTipo {
  CUADRADA
  RECTANGULAR
  REDONDA
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String? // null si se logea con Google
  name     String
  role     Role    @default(USER)
  avatar   String?

  adminRating        Float?
  reservations       Reservation[]
  reviews            Review[]
  restaurants        Restaurant[]        @relation("RestaurantAdmin")
  hiddenReservations HiddenReservation[]
}

model Restaurant {
  id          String  @id @default(uuid())
  name        String
  city        String
  address     String
  phone       String
  description String?

  mesaTipo      MesaTipo?
  mesaCapacidad Int?
  cantidadMesas Int?
  capacity      Int?

  latitude  Float?
  longitude Float?
  images     String[]

  reservations Reservation[]
  reviews      Review[]

  adminId String?
  admin   User?   @relation("RestaurantAdmin", fields: [adminId], references: [id])
  dayCapacities RestaurantDayCapacity[]
}

model RestaurantDayCapacity {
  id           String   @id @default(uuid())
  restaurantId String
  date         DateTime @db.Date
  tablesUsed   Int

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, date])
}

model HiddenReservation {
  id            String @id @default(uuid())
  userId        String
  reservationId String

  user        User        @relation(fields: [userId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, reservationId])
}

model Reservation {
  id                   String            @id @default(uuid())

  date                 DateTime 
  time      String? @default("00:00")

  partySize            Int
  status               ReservationStatus @default(PENDING)
  tablesUsed   Int? 
  cancelReason         String?
  exceptionDescription String?
  completed            Boolean           @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  restaurantId String
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id])
  hiddenBy     HiddenReservation[]
}

model Review {
  id      String  @id @default(uuid())
  rating  Int
  comment String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}
