generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReservationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum MesaTipo {
  CUADRADA
  RECTANGULAR
  REDONDA
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String?       // null si se logea con Google
  name         String
  role         Role          @default(USER)
  avatar       String?

  reservations Reservation[]
  reviews      Review[]
  restaurants  Restaurant[]  @relation("RestaurantAdmin")
}

model Restaurant {
  id            String        @id @default(uuid())
  name          String
  city          String 
  address       String
  phone         String
  description   String?

  mesaTipo      MesaTipo?                     
  mesaCapacidad Int?                           
  cantidadMesas Int?    
  capacity      Int?                        

  reservations  Reservation[]
  reviews       Review[]

  adminId       String?
  admin         User?        @relation("RestaurantAdmin", fields: [adminId], references: [id])
}

model Reservation {
  id           String            @id @default(uuid())
  date         DateTime
  partySize    Int
  status       ReservationStatus @default(PENDING)
  cancelReason  String? 

  exceptionDescription String?

  userId       String
  user         User              @relation(fields: [userId], references: [id])

  restaurantId String
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id])
}

model Review {
  id           String        @id @default(uuid())
  rating       Int
  comment      String?

  userId       String
  user         User          @relation(fields: [userId], references: [id])

  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
}
